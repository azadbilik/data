      "path": "kitabxana/authors.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "description": "Every author on kitabxana.az. 472 rows.",
      "schema": {
        "fields": [
          {
            "name": "slug",
            "type": "string",
            "description": "Identifier, also the page address."
