          {
            "name": "name_az",
            "type": "string"
          },
          {
            "name": "name_ru",
            "type": "string"
          },
          {
            "name": "name_en",
            "type": "string"
          },
          {
            "name": "name_fa",
            "type": "string"
          },
          {
            "name": "born",
            "type": "integer",
            "description": "Year of birth; negative is BCE."
          },
          {
            "name": "born_approx",
            "type": "boolean",
            "trueValues": [
              "true"
            ],
            "falseValues": [
              "false"
            ]
          },
          {
            "name": "died",
            "type": "integer"
          },
          {
            "name": "died_approx",
            "type": "boolean",
            "trueValues": [
              "true"
            ],
            "falseValues": [
              "false"
            ]
          },
          {
            "name": "type",
            "type": "string",
            "description": "poet, writer, philosopher, playwright, critic or folk."
          },
          {
            "name": "period",
            "type": "string",
            "description": "Centuries as written on the site, e.g. \"XVI əsr\"."
          },
          {
            "name": "writing_langs",
            "type": "string",
            "description": "Languages the author wrote in: az_latin, az_arabic, az_cyrillic, fa, ar, ru, en, tr or de. Several values are separated by \";\"."
          },
          {
            "name": "wikidata",
            "type": "string",
            "description": "Wikidata item, e.g. Q312517."
          },
          {
            "name": "works",
            "type": "integer",
            "description": "Published works."
          },
          {
            "name": "tags",
            "type": "string",
            "description": "Tag slugs, see tags.csv. Several values are separated by \";\"."
          },
          {
            "name": "url",
            "type": "string"
          }
        ],
        "primaryKey": [
