            "type": "string"
          },
          {
            "name": "name_fa",
            "type": "string"
          },
          {
            "name": "born",
            "type": "integer",
            "description": "Year of birth; negative is BCE."
          },
          {
            "name": "born_approx",
            "type": "boolean",
            "trueValues": [
              "true"
            ],
            "falseValues": [
              "false"
            ]
          },
          {
            "name": "died",
            "type": "integer"
          },
          {
            "name": "died_approx",
            "type": "boolean",
